<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_adv"
                style="@style/AccentButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开始广播" />

            <TextView
                android:id="@+id/tv_adv_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 数据源 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="数据源 · 没有真传感器也能调" />

            <RadioGroup
                android:id="@+id/rg_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:checkedButton="@id/rb_wave">

                <RadioButton
                    android:id="@+id/rb_wave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="正弦波：每秒变一次，像真房间"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/rb_manual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="手动滑杆：验证零下和 0"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/rb_script"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="剧本：走一遍边界值，最后发 105% 越界"
                    android:textColor="@color/ink" />
            </RadioGroup>
        </LinearLayout>

        <!-- 手动滑杆 -->
        <LinearLayout
            android:id="@+id/card_manual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手动读数" />

            <TextView
                android:id="@+id/tv_temp_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="温度 -40.0 °C"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sb_temp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1250"
                android:progress="651" />

            <TextView
                android:id="@+id/tv_hum_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="湿度 45.2 %"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/sb_hum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progress="452" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="加入电量"
                    android:textColor="@color/ink" />

                <SeekBar
                    android:id="@+id/sb_battery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="90" />

                <TextView
                    android:id="@+id/tv_battery_label"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="90%"
                    android:textColor="@color/ink" />
            </LinearLayout>
        </LinearLayout>

        <!-- 设备身份 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设备身份" />

            <EditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="设备名，例如 QZ-TH01"
                android:inputType="textCapCharacters"
                android:maxLength="40"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_name_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="广播出去的是本机蓝牙名称，停止广播后恢复原名。"
                android:textColor="@color/ink_muted"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cb_connectable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="允许主端连接（GATT，教学扩展）"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/tv_gatt_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未开启"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_remote_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 广播内容 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="广播出去的 BTHome 服务数据" />

            <TextView
                android:id="@+id/tv_hex"
                style="@style/MonoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true" />

            <TextView
                android:id="@+id/tv_explain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_budget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
