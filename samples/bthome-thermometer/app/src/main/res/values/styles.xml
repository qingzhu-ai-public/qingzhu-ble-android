<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bthome" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlHighlight">#1AE8590C</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 主操作按钮：橙底白字 -->
    <style name="AccentButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_accent</item>
        <item name="android:textColor">@color/bar_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">124dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- 次要按钮：描边 -->
    <style name="OutlineButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_outline</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">100dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BodyText">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CaptionText">
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="MonoText">
        <item name="android:background">@drawable/bg_mono</item>
        <item name="android:textColor">@color/mono_fg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>
</resources>
