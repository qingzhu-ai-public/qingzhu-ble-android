<?xml version="1.0" encoding="utf-8"?>
<!-- 青竹 Bamboo 主题：米白窗口底 + 浅色状态栏，避免系统紫/黑状态栏破坏配色 -->
<resources>
    <style name="Theme.Qingzhu" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_deep</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/bg_page</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
