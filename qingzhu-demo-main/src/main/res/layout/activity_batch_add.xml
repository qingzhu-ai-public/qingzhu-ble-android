<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- 标题栏：可点击返回 + 标题 + 副标题（独立页，无底部 Tab） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_card"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="24sp"
            android:textColor="#2F7D5F"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="批量操作"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#20342B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手动录入设备 · 无需先扫到"
                android:textSize="10.5sp"
                android:textColor="#9AA99D"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="使用说明"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#20342B" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="每行一个 deviceMac（或用逗号 / 空格分隔）。这些设备还没 ID，进任务后会先「寻找」。"
                android:textSize="11sp"
                android:textColor="#5B6F63"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="deviceMac 列表"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#5B6F63"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/macInput"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:hint="例如：&#10;02:F5:19:95:E8:D8&#10;83:79:09:45:6C:40"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textSize="12sp"
            android:typeface="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="支持逗号 / 空格 / 换行分隔"
            android:textSize="10sp"
            android:textColor="#9AA99D"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="添加到任务"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/brand"
            app:cornerRadius="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="进任务后 SDK 会先「寻找」设备，找到再执行命令"
            android:textSize="10sp"
            android:textColor="#9AA99D"
            android:gravity="center"
            android:layout_marginTop="14dp" />
    </LinearLayout>
</LinearLayout>
